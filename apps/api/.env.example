# ---- server
PORT=3000

# ---- database: your Supabase project → Project Settings → Database → connection string.
# Local dev uses the docker-compose Postgres instead (npm run db:up).
DATABASE_URL=postgresql://jenna:jenna@localhost:54329/heyjenna

# ---- auth: Supabase Auth. "dev" skips login checks (local only!). "supabase" verifies real tokens.
AUTH_MODE=dev
SUPABASE_URL=
# Only needed for older projects that sign tokens with a shared secret (HS256):
SUPABASE_JWT_SECRET=

# ---- storage for moodboard uploads: "local" (./uploads) or "supabase"
STORAGE_DRIVER=local
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=moodboards

# ---- moodboard vibe reading (optional; without it only colours are extracted)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- product sources (each one switches on when its keys are set; "mock" always works)
SOURCES=mock,ebay,web
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_CA
# Brave Search API, used for Kijiji, Facebook Marketplace and IKEA pages (no scraping of those sites)
BRAVE_SEARCH_API_KEY=

# ---- layout engine
PYTHON_BIN=python3
