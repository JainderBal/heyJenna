# ---- server
PORT=3000

# ---- database: your Supabase project → Project Settings → Database → connection string.
# Local dev uses the docker-compose Postgres instead (npm run db:up).
DATABASE_URL=postgresql://jenna:jenna@localhost:54329/heyjenna

# ---- auth: Supabase Auth. "dev" skips login checks (local only!). "supabase" verifies real tokens.
AUTH_MODE=dev
SUPABASE_URL=
# Only needed for older projects that sign tokens with a shared secret (HS256):
SUPABASE_JWT_SECRET=

# ---- storage for moodboard uploads: "local" (./uploads) or "supabase"
STORAGE_DRIVER=local
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=moodboards

# ---- moodboard vibe reading (optional; without it only colours are extracted)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ---- product sources (each one switches on when its keys are set). Add "mock" for fake offline products.
SOURCES=ikea,ebay,etsy,web
# IKEA country/language (ikea.com/ca/en). Needs no key.
IKEA_LOCALE=ca/en
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_CA
# Etsy Open API v3 keystring (active listings + images). Unset = Etsy uses Brave site:etsy.com results instead.
ETSY_API_KEY=
# Brave Search API, used for Kijiji, Facebook Marketplace and IKEA pages, and Etsy when ETSY_API_KEY is unset (no scraping of those sites)
BRAVE_SEARCH_API_KEY=

# ---- layout engine
PYTHON_BIN=python3

# ---- render workers: shared secret they send as x-worker-token (min 16 chars). Unset = render queue closed.
WORKER_TOKEN=

# ---- browser access: origins the UI runs on (comma-separated)
CORS_ORIGINS=http://localhost:5173
# idle SSE streams (/rooms/:roomId/events) get a ping this often
SSE_HEARTBEAT_MS=20000

# ---- general jobs queue (jobs table), run inside the API. "off" = only enqueue (another instance runs them)
JOBS_RUNNER=on
JOBS_POLL_MS=1000
JOBS_CONCURRENCY=2

# ---- 3D models (GET /models): hosts we fetch GLBs from (https only, max 40 MB, cached in storage)
MODEL_HOSTS=web-api.ikea.com

# ---- Pinterest import (GET /pinterest/boards, …): one API v5 access token for the whole deployment (no OAuth yet). Unset = 501
PINTEREST_ACCESS_TOKEN=
