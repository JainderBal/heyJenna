// Supabase is Postgres, so this schema runs on Supabase as-is.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Room {
  id        String    @id @default(uuid()) @db.Uuid
  ownerId   String    @map("owner_id")           // Supabase auth user id
  name      String
  floorPlan Json      @map("floor_plan")         // contracts FloorPlan
  needs     String[]
  kind      String?                              // contracts RoomKind: bedroom, kitchen, closet…
  furnish   Boolean   @default(true)             // false = on the plan only: no products or layout
  budgetCad Float?    @map("budget_cad")          // this room's furniture budget in CAD; null = not set yet (set before building)
  projectId String?   @map("project_id") @db.Uuid  // optional: rooms can live outside a project
  planX     Float?    @map("plan_x")              // where it sits on the project's plan, metres from the top-left
  planY     Float?    @map("plan_y")              // (null = not placed yet)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  style     Style?
  listings  Listing[]
  layouts   Layout[]

  @@index([ownerId])
  @@index([projectId])
  @@map("rooms")
}

/// A home or job that groups rooms (e.g. "Dundas St condo"). Deleting it keeps its rooms.
model Project {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id")           // Supabase auth user id
  name      String
  kind      String?                              // e.g. condo, house, office
  palette   String[]                             // optional shared hex colours
  budgetCad Float?   @map("budget_cad")          // home furniture budget in CAD; null = no limit
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  rooms     Room[]

  @@index([ownerId])
  @@map("projects")
}

model Style {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @unique @map("room_id") @db.Uuid
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  imageKeys String[] @map("image_keys")          // where the moodboard images are stored
  imageMeta Json     @default("{}") @map("image_meta") // storage key -> { url, link? } for pinned images; keys not listed are uploads
  profile   Json                                  // contracts StyleProfile
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("styles")
}

model Listing {
  id            String   @id @default(uuid()) @db.Uuid
  roomId        String   @map("room_id") @db.Uuid
  room          Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  source        String
  externalId    String   @map("external_id")
  url           String
  title         String
  type          String
  price         Float?
  currency      String
  imageUrl      String?  @map("image_url")
  condition     String
  location      String?
  size          Json?
  sizeEstimated Boolean  @map("size_estimated")
  colours       String[]
  score         Float
  scoreDetail   Json     @map("score_detail")
  picked        Boolean  @default(false)          // the person chose this one for its slot
  modelUrl      String?  @map("model_url")       // 3D model (GLB) from the product page; "" = page checked, none found
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([roomId, source, externalId])
  @@index([roomId, type])
  @@map("listings")
}

model Layout {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  data      Json                                  // engine output: objects, zones, checks
  summary   Json                                  // { pass, warn, fail }
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([roomId])
  @@map("layouts")
}

/// Render queue: the API adds jobs, render workers claim them (FOR UPDATE SKIP LOCKED) and report back.
model RenderJob {
  id         String    @id @default(uuid()) @db.Uuid
  roomId     String    @map("room_id") @db.Uuid
  layoutId   String    @map("layout_id") @db.Uuid
  status     String    @default("queued")   // queued | running | done | failed
  attempts   Int       @default(0)
  workerId   String?   @map("worker_id")
  imageKey   String?   @map("image_key")    // rendered PNG in storage
  modelKey   String?   @map("model_key")    // .glb for the 3D viewer
  error      String?
  createdAt  DateTime  @default(now()) @map("created_at")
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")

  @@index([status, createdAt])
  @@index([layoutId])
  @@map("render_jobs")
}

/// General job queue for work the API does in the background (e.g. kind "listing_search").
/// Same pattern as render_jobs: claimed with FOR UPDATE SKIP LOCKED, failed jobs retry with backoff.
model Job {
  id          String    @id @default(uuid()) @db.Uuid
  kind        String
  payload     Json
  roomId      String?   @map("room_id") @db.Uuid   // for owner checks and live updates; no FK so any job can use the table
  status      String    @default("queued")          // queued | running | done | failed
  attempts    Int       @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  runAfter    DateTime  @default(now()) @map("run_after")
  lockedBy    String?   @map("locked_by")
  result      Json?
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  startedAt   DateTime? @map("started_at")
  finishedAt  DateTime? @map("finished_at")

  @@index([status, runAfter])
  @@index([roomId])
  @@map("jobs")
}
