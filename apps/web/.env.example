# Build-time settings for the studio (Vite reads .env, .env.local, .env.production…).
# Copy to .env.local for local overrides; set them in your web host's build settings in production.
# Everything here ends up in the browser bundle: never put secrets in it.

# The API's base URL. Default /api: in dev Vite proxies /api/* to http://localhost:3000, and the
# desktop app forwards /api/* to its configured API. In production set the hosted API, e.g.
# VITE_API_URL=https://api.heyjenna.app   (and add the web app's URL to the API's CORS_ORIGINS)
VITE_API_URL=

# Login with Supabase. Leave both empty for local dev (the API's AUTH_MODE=dev, no login screen).
# Set both (Project Settings → API: Project URL and the anon public key) together with
# AUTH_MODE=supabase on the API to show the sign-in screen (email magic link + Google).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
